<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>default</LangVersion>

    <!-- Android app identity -->
    <ApplicationId>com.wstune.listener</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <ApplicationTitle>WsTune Listener</ApplicationTitle>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <!-- Android 8.0 (API 26) minimum: Notification channels + ForegroundService required -->

    <!-- Single universal APK (not AAB, not per-ABI) so GitHub Action artifacts install directly -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <!-- arm64 covers all modern phones; arm keeps old devices working -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>

    <!-- SignalR + trimming do not mix (same reason the linux-bionic build ships
         untrimmed): keep trimming/AOT off so the APK just works. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProguard>false</AndroidEnableProguard>
    <AndroidLinkMode>None</AndroidLinkMode>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Stable release signing so Updates install over previous versions.
         Keystore file lives next to this csproj (gitignored); CI materializes it
         from the ANDROID_KEYSTORE_B64 secret. Override passwords via env for local release builds. -->
    <AndroidSigningKeyStore Condition="Exists('$(MSBuildProjectDirectory)/wstune.keystore')">$(MSBuildProjectDirectory)/wstune.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == '' and Exists('$(MSBuildProjectDirectory)/wstune.keystore')">wstune</AndroidSigningKeyAlias>
    <AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' == ''">$(ANDROID_KEYSTORE_PASSWORD)</AndroidSigningStorePass>
    <AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' == ''">$(ANDROID_KEY_PASSWORD)</AndroidSigningKeyPass>
    <!-- When no release keystore/passwords are present, .NET falls back to a
         debug keystore (fine for local Run; CI always passes the real secrets). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <!-- Material Design 3 components (TextInputLayout, MaterialButton, Snackbar,
         MaterialCardView, Chips, MaterialToolbar, MaterialAlertDialog) — the same
         library Google apps are built on. -->
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <!-- Crash reporting → sentry.io (DSN set in code). -->
    <PackageReference Include="Sentry" Version="6.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libraries\WsTune.SignalR.Extensions\WsTune.SignalR.Extensions.csproj" />
    <ProjectReference Include="..\Libraries\WsTuneCommon\WsTuneCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="Assets/appsettings.listener.json" />
  </ItemGroup>

</Project>
