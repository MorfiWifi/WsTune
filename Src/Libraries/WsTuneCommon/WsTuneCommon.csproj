<!--
  This netstandard2.0 library is shared by the .NET 10 endpoints and the net48 client.
  TreatAsLocalProperty keeps executable publish and platform globals from changing how the
  shared library itself is built.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PlatformTarget;PublishAot;PublishTrimmed;PublishSingleFile;EnableCompressionInSingleFile">

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PlatformTarget>AnyCPU</PlatformTarget>

        <!-- The executable's linker processes this assembly during the final publish. -->
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.0" />
      <PackageReference Include="System.Buffers" Version="4.6.1" />
      <PackageReference Include="System.Memory" Version="4.6.3" />
      <PackageReference Include="System.Net.WebSockets" Version="4.3.0" />
      <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    </ItemGroup>

</Project>
